# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
*.tsbuildinfo

# local env files
.env
.env*.local

# uploads (v1 stores sponsor assets here; swap to S3/Cloudinary later)
/public/uploads/*
!/public/uploads/.gitkeep

# prisma local db (if used for quick dev)
*.db

# local-only Prisma engines (downloaded via curl; CI/prod fetch their own)
/.prisma-engines/
