# ------------------------------------------------------------------
# JobRoomFinder — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Prisma) — Milestone 2 -------------------------------
# MySQL on Hostinger Business. Keep schema portable so we can swap to
# Postgres/Neon later.
DATABASE_URL="mysql://user:password@localhost:3306/jobroomfinder"

# --- Session cookie (our own) — Milestone 3 ------------------------
# 32+ char random string for signing the httpOnly session JWT.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Firebase Phone Auth — Milestone 3 -----------------------------
# PUBLIC (safe to ship to the client):
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# SECRET (Admin SDK service account — server only, NEVER expose):
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Stripe — Milestones 6 & 7 -------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Prices in AUD cents, stored as integers in the app.
BOOST_PRICE_CENTS="500"
SPONSOR_PRICE_CENTS="5000"

# --- Email (transactional) — behind EmailProvider seam -------------
# Resend OR Hostinger SMTP (Nodemailer). Fill whichever you use.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="JobRoomFinder <hello@jobroomfinder.com.au>"
ADMIN_EMAIL="admin@jobroomfinder.com.au"
